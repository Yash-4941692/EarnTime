{
  "manifest_version": 3,
  "name": "EarnTime",
  "version": "2.6.6",
  "description": "Study to earn screen time. Counts only active study time, enforces unproductive-site limits, and repays overspending through study.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "idle",
    "notifications",
    "declarativeNetRequest"
  ],
  "optional_permissions": [
    "history"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "EarnTime",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "adult_guard",
        "enabled": true,
        "path": "rules/adult_guard.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "block.html",
        "motivation.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
