{
  "name": "earntime-extension",
  "version": "2.0.0",
  "private": true,
  "description": "Source for the EarnTime Chrome extension (Manifest V3). Build output is written to the repository root.",
  "license": "MIT",
  "scripts": {
    "build": "node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "package": "node scripts/package.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "npm run typecheck",
    "test:unit": "node test/run-unit.mjs",
    "test:sim": "node test/run-sim.mjs",
    "test:browser": "node test/browser/run.mjs",
    "test": "npm run typecheck && npm run test:unit && npm run test:sim",
    "test:all": "npm test && npm run test:browser"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.12",
    "playwright-core": "^1.64.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}
